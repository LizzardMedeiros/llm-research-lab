# Copy to .env and fill in only what you use. Endpoints are defined in
# providers.yaml; a key is only required when an experiment uses its endpoint.

# claude
ANTHROPIC_API_KEY=

# gemini
GEMINI_API_KEY=

# umaraiz
UMARAIZ_BASE_URL=
UMARAIZ_API_KEY=

# Enable the NVIDIA GPU for Ollama (llamacpp always uses it)
# COMPOSE_FILE=compose.yaml:compose.gpu.yaml

# llamacpp: serve another GGUF from Hugging Face
# LLAMACPP_MODEL_REPO=prism-ml/Ternary-Bonsai-2-27B-gguf
# LLAMACPP_MODEL_FILE=Ternary-Bonsai-2-27B-PTQ1_0.gguf

# Host ports
LAB_PORT=3100
OLLAMA_PORT=11434
LLAMACPP_PORT=8090
